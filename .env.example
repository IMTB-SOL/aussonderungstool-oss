# Beispielkonfiguration — nach .env kopieren und anpassen.
# Die Datei .env enthält Geheimnisse und gehört nicht in die Versionsverwaltung.

# --- Betriebsart -------------------------------------------------------------
# development | production. In production: API-Doku (/docs) aus, Cookies mit
# Secure-Flag, SESSION_SECRET ist Pflicht (mind. 32 Zeichen).
APP_ENV=development

# --- Anmeldung ---------------------------------------------------------------
# passwort | azure | beide | disabled
# Ohne Angabe ist die Anmeldung immer aktiv (passwort bzw. beide, wenn Azure
# konfiguriert ist). "disabled" schaltet sie ausdrücklich ab — nur für lokale
# Entwicklung oder wenn ein vorgeschalteter Dienst den Zugriff absichert.
AUTH_MODUS=passwort
AUTH_PASSWORT_MIN=12
# Schlüssel zum Signieren der Session-Cookies. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Secure-Flag der Cookies. Default: true in production, sonst false.
# COOKIE_SECURE=true
# Erst-Admin, wird beim ersten Start angelegt (Passwort mind. AUTH_PASSWORT_MIN Zeichen).
# Weitere Nutzer registrieren sich selbst und werden im Admin-Bereich freigeschaltet.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=
# Microsoft Entra ID (nur bei AUTH_MODUS=azure oder beide)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# Rate-Limits für Registrierung und Login (pro IP, Zeitfenster in Sekunden)
# AUTH_REGISTER_MAX=3
# AUTH_REGISTER_WINDOW=600
# AUTH_LOGIN_MAX=10
# AUTH_LOGIN_WINDOW=300

# --- Sprachmodell (OpenAI-kompatible API) --------------------------------------
# Standard: lokale Ollama-Instanz. Modellname an das eigene Modell anpassen;
# empfohlen wird ein Modell mit großem Kontextfenster.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
# Optionaler zweiter Anbieter (Scaleway Generative APIs). Erst nach
# datenschutzrechtlicher Prüfung aktivieren — Akteninhalte verlassen dann das eigene Netz.
SCALEWAY_ENABLED=false
SCALEWAY_BASE_URL=https://api.scaleway.ai/<projekt-id>/v1
SCALEWAY_MODEL=gpt-oss-120b
SCALEWAY_API_KEY=
# Parallele LLM-Aufrufe der Tiefenprüfung (bei lokalem Ollama 1–2)
TIEFENPRUEFUNG_LLM_PARALLEL=4

# --- Verarbeitung --------------------------------------------------------------
# Pfad zum veraPDF-Aufruf (Pflicht). Im Container-Image bereits gesetzt.
# Lokal: Wrapper um das mitgelieferte JAR, siehe docs/entwicklung.md.
VERAPDF_PATH=/opt/verapdf/verapdf
PDFA_ZIELFORMAT=2b
# Worker-Prozesse der Textextraktion (leer = alle CPU-Kerne)
EXTRAKTION_PARALLEL=
# Tesseract-Sprachen, z. B. deu oder deu+eng
OCR_LANG=deu

# --- Daten ---------------------------------------------------------------------
DATA_DIR=./data
DATABASE_URL=sqlite:///./aussonderung.db
MAX_UPLOAD_SIZE_MB=500
# Jobs werden nach dieser Zahl von Tagen automatisch gelöscht
JOB_RETENTION_TAGE=30

# --- Betrieb -------------------------------------------------------------------
# Bearer-Token für /metrics (ohne Token liefert der Endpunkt 503)
METRICS_TOKEN=
# Erlaubte Origins, kommagetrennt (leer = nur Same-Origin)
# CORS_ORIGINS=https://aussonderungstool.example.com
# Auslieferung unter einem Unterpfad, z. B. /aussonderungstool (leer = /)
BASE_PATH=
# Impressum und Datenschutzerklärung des Betreibers (Pfade zu HTML-Dateien)
# IMPRESSUM_DATEI=/app/data/impressum.html
# DATENSCHUTZ_DATEI=/app/data/datenschutz.html
